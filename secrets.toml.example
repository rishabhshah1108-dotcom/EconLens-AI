# Add these in Streamlit Community Cloud > App settings > Secrets.
# Create a separate PRIVATE GitHub repository (e.g. qxiao2ub/econolens-usage-data).
# Create a GitHub fine-grained personal access token restricted to that repository
# with Contents: Read and write. The Streamlit app source repo needs no write access.
# NEVER commit real tokens or a real secrets.toml to GitHub.
GITHUB_COUNTER_TOKEN = "github_pat_REPLACE_WITH_YOUR_TOKEN"
GITHUB_COUNTER_REPO = "qxiao2ub/econolens-usage-data"
GITHUB_COUNTER_PATH = "econolens-visits.json"
GITHUB_COUNTER_BRANCH = "main"
GITHUB_COUNTER_INITIAL_TOTAL = "0"  # set prior cumulative total once, if migrating
